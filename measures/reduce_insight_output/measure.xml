  <class_name>ReduceInsightOutput</class_name>
  <display_name>Reduce Insight Output</display_name>
  <description>Reduces the output SQLFile file size to the minimum required for Insight360. Optionally suppresses other output files.</description>
  <modeler_description></modeler_description>
  <arguments>
    <argument>
      <name>suppress_files</name>
      <display_name>Suppress Output Files</display_name>
      <description>Suppresses all output files except eplusout.sql from being generated for the run.</description>
      <type>Boolean</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>true</default_value>
      <choices>
        <choice>
          <value>true</value>
          <display_name>true</display_name>
        </choice>
        <choice>
          <value>false</value>
