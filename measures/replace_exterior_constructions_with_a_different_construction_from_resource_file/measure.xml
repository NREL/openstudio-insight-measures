  <class_name>ReplaceExteriorConstructionsWithADifferentConstructionFromResourceFile</class_name>
  <display_name>Replace Exterior Constructions with a Different Construction from Resource File</display_name>
  <description>Replace exterior wall, roof, or window constructions, with an existing construction from a construction imported from a resource file.</description>
  <modeler_description>This will take an argument for a target construction to import from a resource GbXML file. How that construction is applied in the model or tagged in the resource file will determine which surface types the construction is applied to.</modeler_description>
  <arguments>
    <argument>
      <name>new_construction</name>
      <display_name>Target Construction from Library to use for Exterior Surface Replacement</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <choices>
        <choice>
          <value>R-13+R13 metal frame + ins. panel (SIP) wall, 14\", 4 1/2 in (114 mm)</value>
          <display_name>R-13+R13 metal frame + ins. panel (SIP) wall, 14\", 4 1/2 in (114 mm)</display_name>
        </choice>
        <choice>
          <value>Membrane, sheathing, R-15 insulation, 4 1/4 in light concrete</value>
          <display_name>Membrane, sheathing, R-15 insulation, 4 1/4 in light concrete</display_name>
        </choice>
        <choice>
          <value>Low-E double glazing (1/4 in + 1/4 in) U-1.98 SHGC-0.56</value>
          <display_name>Low-E double glazing (1/4 in + 1/4 in) U-1.98 SHGC-0.56</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>facade</name>
      <display_name>Cardinal Direction.</display_name>
      <description>Constructions will be applied to the specified facade or facades.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>All</default_value>
      <choices>
        <choice>
          <value>North</value>
          <display_name>North</display_name>
        </choice>
        <choice>
          <value>East</value>
          <display_name>East</display_name>
        </choice>
        <choice>
          <value>South</value>
          <display_name>South</display_name>
        </choice>
        <choice>
          <value>West</value>
          <display_name>West</display_name>
        </choice>
        <choice>
          <value>All</value>
          <display_name>All</display_name>
        </choice>
      </choices>
    </argument>
  </arguments>
